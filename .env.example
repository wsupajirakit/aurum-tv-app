# Copy to .env (git-ignored) and fill in:
#   cp .env.example .env
#
# Variables starting with EXPO_PUBLIC_ are embedded into the app at build time.
# Never put the backend admin API key here — the TV app only needs its HMAC signing key.

# Backend address
#   Android TV emulator        : http://10.0.2.2:3000   (10.0.2.2 = your computer, seen from the emulator)
#   real TV/box on the same LAN : http://192.168.1.xxx:3000   (address of the machine running the backend)
#   deployed                    : https://tv-api.example.com
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# ---- HMAC signing (must match the backend: HMAC_KEYS=<KEY_ID>:<SECRET>) ----
# Generate a pair with the backend tool:  go run ./cmd/aurumctl genkey
# Not set = the app does not sign → only works while the backend runs HMAC_MODE=off or log.
# This value ships inside the APK (it can be extracted): it proves a request comes from the app,
# it is not an admin credential.
EXPO_PUBLIC_HMAC_KEY_ID=tv1
EXPO_PUBLIC_HMAC_SECRET=
